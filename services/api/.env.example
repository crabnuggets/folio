# Copy values into your shell or local secrets manager; the server does not load .env automatically.
APP_ENV=development
AUTH_MODE=dev
OWNER_ID=11111111-1111-4111-8111-111111111111
# Generate a private local token (at least 32 characters); never commit its value.
DEV_AUTH_TOKEN=
DATABASE_URL=postgres://folio:folio-local-only@localhost:5432/folio?sslmode=disable
PORT=8080
# Optional built React bundle directory. Leave unset for API-only mode and local Vite proxy development.
# WEB_DIST_DIR=../../apps/web/dist

# Production: APP_ENV=production, AUTH_MODE=jwt, DATABASE_URL with sslmode=verify-full.
# Supabase Auth settings: disable public signup and invite only OWNER_ID.
# JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# JWT_AUDIENCE=authenticated
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_<public-key>
# Required for Google sign-in. Never use sb_secret_ or a service-role key.
# Enable Google in Supabase Auth. In Google Cloud, allow the Supabase callback:
# https://<project-ref>.supabase.co/auth/v1/callback
# In Supabase Auth URL Configuration, allow the app's exact popup callback:
# https://<your-app-host>/auth/callback
# Invite the owner with their Google email, keep public signup disabled, and set
# OWNER_ID to that Supabase user's UUID. Use an active ES256 or RS256 signing key.
# JWKS is pinned to JWT_ISSUER + /.well-known/jwks.json.
